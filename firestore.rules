// =====================================================================================
// Bike Tours R Us (2027 app): Firestore rules ADDITIONS.
//
// Your Firebase project already has rules for the 2026 crew app (isCrew(), /crew, /wall, /live).
// KEEP those exactly as they are, so the 2026 app keeps working.
// Copy ONLY the block between the two marker lines below and paste it inside your existing
//     match /databases/{database}/documents { ... }
// block, just before its final closing brace. Then tap Publish.
// No emails go in this file: editors live in Firestore at admins/editors (see README).
// =====================================================================================

    // ----- Bike Tours R Us: copy from here -----
    function signedInWithEmail() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isEditor() {
      return signedInWithEmail()
        && exists(/databases/$(database)/documents/admins/editors)
        && myEmail() in get(/databases/$(database)/documents/admins/editors).data.emails;
    }
    function onTour(t) {
      return signedInWithEmail()
        && myEmail() in get(/databases/$(database)/documents/tours/$(t)).data.memberEmails;
    }

    // The editors list: anyone signed in can check it; only you can change it, in the Firebase console.
    match /admins/{doc} {
      allow read: if signedInWithEmail();
      allow write: if false;
    }

    // Tours: editors (you and Tony) read and change everything; riders read tours they're on.
    match /tours/{t} {
      allow read: if isEditor() || (signedInWithEmail() && myEmail() in resource.data.memberEmails);
      allow write: if isEditor();

      match /{rest=**} {
        allow read: if isEditor() || onTour(t);
        allow write: if isEditor();
      }

      // Ride-day features (added in app v4.0). Riders on the tour can also write these:
      // their own passport, scores, trivia, votes and Koala Court charges (one document each, only theirs)
      match /riders/{uid} {
        allow write: if request.auth != null && request.auth.uid == uid && (onTour(t) || isEditor());
      }
      // the shared "We're here" position
      match /live/{doc} {
        allow write: if onTour(t);
      }
      // photo wall: add your own, delete your own (editors can delete any)
      match /wall/{id} {
        allow create: if onTour(t) && request.resource.data.uid == request.auth.uid;
        allow delete: if onTour(t) && resource.data.uid == request.auth.uid;
      }
      match /wallfull/{id} {
        allow create: if onTour(t);
        allow delete: if onTour(t) && get(/databases/$(database)/documents/tours/$(t)/wall/$(id)).data.uid == request.auth.uid;
      }
      // bakeries riders find on the road
      match /extras/{id} {
        allow create: if onTour(t) && request.resource.data.uid == request.auth.uid;
        allow delete: if onTour(t) && resource.data.uid == request.auth.uid;
      }
    }
    // ----- Bike Tours R Us: copy to here -----
